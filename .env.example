# Copy this file to `.env` and fill in real values.
# The real `.env` is gitignored and must NEVER be committed.

# --- LLM provider ---
# Choose ONE provider via LLM_PROVIDER. Supported: "gemini" | "groq".
LLM_PROVIDER=groq

# Gemini: get a free key at https://aistudio.google.com/apikey
# (Note: gemini-2.5-flash free tier is ~20 requests/day.)
# Required even if LLM_PROVIDER=groq: resume-evidence retrieval always
# embeds with Gemini's free-tier embedding API (Groq has no embeddings API).
GOOGLE_API_KEY=your-gemini-api-key-here

# Groq: get a free key (no card) at https://console.groq.com/keys
# Much higher free tier (~14,400 requests/day).
GROQ_API_KEY=your-groq-api-key-here

# Model name for the chosen provider. Sensible defaults are used if unset.
#   gemini -> gemini-2.5-flash | gemini-2.0-flash
#   groq   -> llama-3.3-70b-versatile
LLM_MODEL=llama-3.3-70b-versatile

# Embedding model for resume-evidence retrieval (always Gemini; see above).
# Defaults to "gemini-embedding-001" if unset.
EMBEDDING_MODEL=gemini-embedding-001

# --- Application ---
APP_ENV=development
LOG_LEVEL=INFO

# --- Run history ---
# Required on Vercel: a PostgreSQL connection URL from your database provider.
# Use its pooled URL with TLS (e.g. sslmode=require).
# Set this as a Vercel secret, never in frontend code.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
# Local development only; ignored when DATABASE_URL is set.
DB_PATH=runs.db
